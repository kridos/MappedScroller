{
  "manifest_version": 3,
  "name": "MappedScroller",
  "version": "0.1.0",
  "description": "Scroll two tabs together, keeping matching headings and numbered questions lined up.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MappedScroller",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-sync": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Pause / resume synced scrolling"
    }
  }
}
